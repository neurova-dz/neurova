<IfModule Litespeed>
SetEnv SECRET_KEY CHANGE-ME
SetEnv DATABASE_URL mysql+pymysql://neurova_user:neurova_password@localhost/neurova_db
SetEnv BRAIN_MODEL_PATH storage/models/brain/model_phase_1.keras
SetEnv RETINA_MODEL_PATH storage/models/retina/best_pytorch_h100_aptos.pth
